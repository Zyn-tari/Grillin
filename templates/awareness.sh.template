#!/usr/bin/env bash
# awareness.sh — report where the work actually is, computed from disk.
#
# Starting point, not a finished tool. Adjust the CONFIG block to your layout.
# See _AWARENESS.md for what this is for and why it must never block.
#
#   awareness.sh ambient        one line: position only
#   awareness.sh checkpoint     the full picture, for a boundary
#   awareness.sh precompact     what must survive the summary — fire before compaction
#   awareness.sh situational F  non-blocking note if file F belongs to someone else
#   awareness.sh stale          one line, only if a status looks untended
#   awareness.sh record         SILENT: log a transition, refresh the published surface
#   awareness.sh surface        print the published surface (what the requester reads)
#
# Contract with the harness:
#   - always exits 0, on every path, including every error
#   - `record` prints NOTHING — it is for the requester, never the agent
#   - never touches the plan, the task files or the changelog;
#     its only writes are its own log and the surface it publishes
#   - no network, no model calls
#
# A reminder that breaks a tool call is worse than no reminder.

set -uo pipefail   # deliberately no -e: a missing file must never abort a hook

# ─── CONFIG ────────────────────────────────────────────────────────────────
ROOT="${AWARENESS_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
TASK_GLOB="${AWARENESS_TASK_GLOB:-tasks/*/TASK.md}"   # each contains a Status: line
CHANGELOG="${AWARENESS_CHANGELOG:-CHANGELOG.md}"      # principle 13 receipts
PLAN="${AWARENESS_PLAN:-PLAN.md}"
STATUS_RE='^\*\*Status:\*\*[[:space:]]*'
LOG="${AWARENESS_LOG:-.awareness/progress.log}"       # append-only transition log
SURFACE="${AWARENESS_SURFACE:-PROGRESS.md}"           # what the requester reads
# A task counts as verified only once its done-command has actually run and a
# worker recorded that fact here. Absence means "claimed", never "failed".
VERIFIED="${AWARENESS_VERIFIED:-.awareness/verified}" # one task id per line
# Contended-file list from phase 7: "<path-or-glob><TAB><owner>" per line.
OWNERS="${AWARENESS_OWNERS:-OWNERS}"
# ───────────────────────────────────────────────────────────────────────────

cd "$ROOT" 2>/dev/null || exit 0
mode="${1:-ambient}"

# Situational runs before everything else: it answers a question about one file
# and does not depend on any task existing. It NEVER blocks — it prints a note
# and exits 0, always. Denial is enforcement's job, not this file's.
if [ "$mode" = "situational" ]; then
  target="${2:-}"
  [ -n "$target" ] || exit 0
  [ -f "$OWNERS" ] || exit 0
  rel="${target#"$ROOT"/}"
  while IFS="$(printf '\t')" read -r pattern owner; do
    case "$pattern" in ''|'#'*) continue ;; esac
    # shellcheck disable=SC2254 — pattern is intentionally a glob
    case "$rel" in
      $pattern)
        echo "note: $rel is owned by ${owner}. If that is not you, emit a fragment for the integrator rather than editing it — see the contended-file list."
        exit 0
        ;;
    esac
  done <"$OWNERS"
  exit 0
fi

# Collect "<id>\t<status>" per task. Empty output is a valid, expected state.
tasks() {
  local f id status
  for f in $TASK_GLOB; do
    [ -f "$f" ] || continue
    id="$(basename "$(dirname "$f")")"
    status="$(grep -m1 -E "$STATUS_RE" "$f" 2>/dev/null \
              | sed -E "s/$STATUS_RE//; s/[[:space:]]*\$//; s/ *—.*//")"
    printf '%s\t%s\n' "$id" "${status:-NO STATUS LINE}"
  done
}

# grep -c already prints 0 when nothing matches; it just exits 1. Adding `|| echo 0`
# would emit "0\n0" and every later integer test would break on it.
count_of() { tasks | grep -ciF "	$1" 2>/dev/null | head -1; }
ids_of()   { tasks | grep -iF "	$1" 2>/dev/null | cut -f1 | paste -sd' ' - ; }

# A DONE status is a claim. It is evidence only if the task's done-command ran.
is_verified() { [ -f "$VERIFIED" ] && grep -qxF "$1" "$VERIFIED" 2>/dev/null; }
done_split() {
  local id v="" c=""
  while IFS="$(printf '\t')" read -r id status; do
    case "$status" in
      DONE|done|Done) if is_verified "$id"; then v="$v $id"; else c="$c $id"; fi ;;
    esac
  done <<EOF
$TASKS
EOF
  printf '%s\t%s\n' "${v# }" "${c# }"
}

TASKS="$(tasks)"

if [ -z "$TASKS" ]; then
  # Degrade out loud — silence reads as "everything is fine". Except in `record`,
  # whose whole contract is to print nothing; there, saying so would inject text
  # into the agent that this register exists specifically to avoid.
  [ "$mode" = "record" ] || \
    echo "awareness: no task files match '$TASK_GLOB' under $ROOT — nothing to report"
  exit 0
fi

total=$(printf '%s\n' "$TASKS" | wc -l | tr -d ' ')
done_n=$(count_of "DONE")
prog_n=$(count_of "IN PROGRESS")
block_n=$(count_of "BLOCKED")
blocked_ids="$(ids_of "BLOCKED")"
active_ids="$(ids_of "IN PROGRESS")"

case "$mode" in

  ambient)
    line="${done_n}/${total} done"
    [ "$prog_n"  -gt 0 ] && line="$line · active: ${active_ids}"
    [ "$block_n" -gt 0 ] && line="$line · BLOCKED: ${blocked_ids}"
    echo "$line"
    ;;

  stale)
    # Cheap honesty check: work committed recently while nothing is marked active.
    recent="$(git log --since='2 hours ago' --oneline 2>/dev/null | wc -l | tr -d ' ')"
    if [ "${recent:-0}" -gt 0 ] && [ "$prog_n" -eq 0 ]; then
      echo "awareness: ${recent} commit(s) in the last 2h but no task is IN PROGRESS — is a status line untended?"
    fi
    ;;

  checkpoint)
    echo "── where the work is ─────────────────────────────────"
    printf 'PROGRESS : %s of %s done' "$done_n" "$total"
    [ "$block_n" -gt 0 ] && printf ' · %s blocked' "$block_n"
    printf '\n'

    [ -n "$active_ids"  ] && echo "IN FLIGHT: $active_ids"
    [ -n "$blocked_ids" ] && echo "BLOCKED  : $blocked_ids"

    notstarted="$(ids_of "NOT STARTED")"
    [ -n "$notstarted" ] && echo "REMAINING: $notstarted"

    if [ -f "$CHANGELOG" ]; then
      # List items only — a heading is not an amendment.
      amendments="$(grep -cE '^[-*] ' "$CHANGELOG" 2>/dev/null | head -1)"
      echo "CHANGED  : ${amendments} plan amendment(s) recorded — see $CHANGELOG"
      # Most recent receipt is the one most likely to be news.
      last="$(grep -m1 -E '^[-*] ' "$CHANGELOG" 2>/dev/null | cut -c1-100)"
      [ -n "$last" ] && echo "  latest → $last"
    else
      echo "CHANGED  : no $CHANGELOG — deviations are not being recorded (principle 13)"
    fi

    [ -f "$PLAN" ] || echo "PLAN     : no $PLAN found at $ROOT"

    recent="$(git log --oneline -3 2>/dev/null)"
    if [ -n "$recent" ]; then
      echo "RECENT   :"
      printf '  %s\n' "$recent"
    fi
    echo "──────────────────────────────────────────────────────"
    ;;

  precompact)
    # Fired immediately before the context is summarised — the one moment where
    # injected state lands INSIDE the summary instead of being what the summary
    # drops. So this output is written for the agent that exists AFTER the
    # summary: it carries position, and it carries how to recover the rest.
    # Keep it short. Everything here competes for room in the summary.
    echo "── carry this through the summary ────────────────────"
    printf 'POSITION : %s of %s done' "$done_n" "$total"
    [ -n "$active_ids"  ] && printf ' · in flight: %s' "$active_ids"
    [ -n "$blocked_ids" ] && printf ' · BLOCKED: %s' "$blocked_ids"
    printf '\n'

    if [ -f "$CHANGELOG" ]; then
      last="$(grep -m1 -E '^[-*] ' "$CHANGELOG" 2>/dev/null | cut -c1-90)"
      [ -n "$last" ] && echo "LAST CHANGE: $last"
    fi

    # The durable state is on disk. Say where, so the post-summary agent can
    # rebuild what the summary lost instead of trusting what it remembers.
    echo "TRUTH LIVES IN (re-read rather than recall):"
    [ -f "$PLAN" ] && echo "  · $PLAN — amended in place; it is current by construction"
    echo "  · $TASK_GLOB — status lines are the progress record"
    [ -f "$CHANGELOG" ] && echo "  · $CHANGELOG — what changed since the plan was written"
    echo "  · git log / git status — what actually landed"
    echo "RECOVER WITH: $0 checkpoint"
    echo "──────────────────────────────────────────────────────"
    ;;

  record)
    # SILENT. Fired when a status line is written — the one work-shaped event
    # available. Prints nothing: this register is for the requester, and echoing
    # it back turns the status line into a performance.
    mkdir -p "$(dirname "$LOG")" 2>/dev/null
    stamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
    prev="$(tail -1 "$LOG" 2>/dev/null | cut -f2- )"
    now="$(printf '%s\n' "$TASKS" | tr '\n' ';')"
    # Only append on an actual change — an unchanged snapshot is not a transition.
    if [ "$prev" != "$now" ]; then
      printf '%s\t%s\n' "$stamp" "$now" >>"$LOG" 2>/dev/null
    fi
    "$0" surface >"$SURFACE" 2>/dev/null
    ;;

  surface)
    # What the requester reads without having to ask. Claims and evidence are
    # reported in different columns on purpose.
    split="$(done_split)"
    verified="$(printf '%s' "$split" | cut -f1)"
    claimed="$(printf '%s' "$split" | cut -f2)"
    echo "# Progress"
    echo
    echo "_Generated from task status lines. \`DONE\` is a worker's claim; **verified** means the"
    echo "task's own done-command was run and recorded._"
    echo
    echo "| State | Tasks |"
    echo "|---|---|"
    [ -n "$verified"    ] && echo "| done — verified | $verified |"
    [ -n "$claimed"     ] && echo "| done — claimed, ungated | $claimed |"
    [ -n "$active_ids"  ] && echo "| in progress | $active_ids |"
    [ -n "$blocked_ids" ] && echo "| blocked | $blocked_ids |"
    ns="$(ids_of 'NOT STARTED')"; [ -n "$ns" ] && echo "| not started | $ns |"
    echo
    echo "${done_n} of ${total} tasks report done."
    if [ -n "$claimed" ]; then
      echo
      echo "> ⚠ ${claimed} report done without a recorded gate run."
    fi
    if [ -f "$LOG" ]; then
      echo
      echo "Last transition: $(tail -1 "$LOG" 2>/dev/null | cut -f1)"
    fi
    ;;

  *)
    echo "awareness: unknown mode '$mode' (expected: ambient | checkpoint | precompact | situational | stale | record | surface)"
    ;;
esac

exit 0
